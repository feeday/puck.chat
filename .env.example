# HTTP server
PORT=3000
HOST=0.0.0.0

# Optional server-side Doubao API keys. Leave blank to let each user configure
# their own keys in the page. Never commit a real API key to Git.
DOUBAO_ASR_API_KEY=
DOUBAO_TTS_API_KEY=
DOUBAO_API_KEY=

# Doubao ASR 2.0, duration billing
DOUBAO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# Doubao TTS 2.0
DOUBAO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
